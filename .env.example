# ============================================================
#  AlphaDesk configuration  —  copy to `.env` and fill in.
#  cp .env.example .env
# ============================================================

# ---------------- Dhan API v2 (trading & market data) --------
# Get these from https://web.dhan.co  ->  DhanHQ Trading APIs
# (Profile picture -> DhanHQ Trading APIs -> Generate Access Token)
# NOTE: Dhan access tokens expire (usually daily). Regenerate and
# re-paste when the bot logs 401 errors.
DHAN_CLIENT_ID=1101234567
DHAN_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.......

# ---------------- Trading mode -------------------------------
# MARKET_DATA_MODE: auto | dhan | yfinance | sim
#   auto     -> Dhan if creds present, else yfinance, else offline sim
#   dhan     -> force Dhan API (requires creds above)
#   yfinance -> free Yahoo Finance data (15-min delayed, good for swing)
#   sim      -> fully offline synthetic feed (demo / CI / no internet)
MARKET_DATA_MODE=auto

# Execution is ALWAYS paper in this build (see README -> Going live).
LIVE_TRADING=false

# ---------------- Capital & risk -----------------------------
CAPITAL_INR=100000
RISK_PER_TRADE_PCT=1.0          # 1% of equity at risk per trade
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=2.0        # kill-switch: stop fresh entries for the day
MAX_TRADES_PER_DAY=6

# ---------------- Telegram alerts ----------------------------
# 1) Talk to @BotFather on Telegram -> /newbot -> copy the token here
# 2) Get your numeric chat id from @userinfobot (or getUpdates)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:AA...your...botfather...token
TELEGRAM_CHAT_ID=123456789

# ---------------- Strategy tuning (sane defaults) ------------
ML_PROB_GATE_INTRADAY=0.56      # ML P(up) must exceed this for intraday entries
ML_PROB_GATE_SWING=0.58
MAX_NOTIONAL_PER_STOCK_PCT=25   # max % of equity in one stock
SECTOR_CONCENTRATION_PCT=40     # max % of equity in one sector
SLIPPAGE_BPS=5                  # paper-fill slippage (basis points)

# ---------------- Housekeeping -------------------------------
LOG_LEVEL=INFO
UNIVERSE_FILE=config/nifty50.json
PORT=8000
